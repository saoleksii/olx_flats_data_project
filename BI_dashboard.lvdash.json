{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "rent_mart",
      "queryLines": [
        "SELECT\n",
        "    f.ads_id,\n",
        "    f.price_uah,\n",
        "    f.size_m2,\n",
        "    f.price_per_m2,\n",
        "    f.size_category,\n",
        "    l.district,\n",
        "    d.clean_date,\n",
        "    d.year,\n",
        "    d.month,\n",
        "    d.day_of_week,\n",
        "    i.title,\n",
        "    i.url\n",
        "FROM workspace.default.fact_ads f\n",
        "LEFT JOIN workspace.default.dim_location l ON f.location_id = l.location_id\n",
        "LEFT JOIN workspace.default.dim_date d ON f.date_id = d.date_id\n",
        "LEFT JOIN workspace.default.dim_info i ON f.info_id = i.info_id"
      ]
    }
  ],
